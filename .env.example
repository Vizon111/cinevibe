# TMDB API key (v3 auth key or v4 read-access JWT — both work).
# Get a free key at https://www.themoviedb.org/settings/api
# Required — the app has no bundled key, and every page will show
# a setup screen with instructions until this is set.
TMDB_API_KEY=

# Public site URL, used to build absolute Open Graph / canonical URLs.
# Set this to your Vercel deployment URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
