# TMDB API key (v3 auth key or v4 read-access JWT — both work).
# Get a free key at https://www.themoviedb.org/settings/api
# Required — the app has no bundled key, and every page will show
# a setup screen with instructions until this is set.
TMDB_API_KEY=

# OMDb API key — used to show the real IMDb rating alongside TMDB's own
# score. Get a free key (1,000 requests/day) at
# https://www.omdbapi.com/apikey.aspx — check your email and click the
# activation link, or the key won't work.
# Optional: if unset, the IMDb rating is simply omitted from the page
# (the rest of the app, including the TMDB rating, works fine without it).
OMDB_API_KEY=

# Public site URL, used to build absolute Open Graph / canonical URLs.
# Set this to your Vercel deployment URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
